# 阿里云百炼 DashScope（Qwen 模型），申请入口：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-你的key

# Tavily 搜索 MCP，免费额度，注册后在控制台获取：https://app.tavily.com
TAVILY_API_KEY=tvly-你的key

# 高德地图 MCP，免费申请（服务平台选「Web服务」）：https://console.amap.com
AMAP_MAPS_API_KEY=你的key

# 门票助手（case-function-calling）使用的 MySQL 连接信息，销售业务助手不需要（它用本地 SQLite）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=你的用户名
MYSQL_PASSWORD=你的密码
MYSQL_DATABASE=ubr
